# Supabase (producción). Sin estas dos variables la app usa memoria: sirve en local, no en Vercel.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Claves privadas de los emisores: JSON { id: semillaHex32bytes }. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin esta variable se usan claves de desarrollo derivadas de una semilla fija (marcadas en /emisores).
EMISOR_KEYS={"uni-demo":"<hex>","eduhub":"<hex>"}
